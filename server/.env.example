# Copy to .env and fill values.

# HTTP port for Express (default 4000 if omitted)
PORT=4000

# MongoDB Atlas connection string (required). Database name is part of the URI path; case-sensitive.
# Format (Atlas driver connection):
# mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
#
# Example (password must be URL-encoded if it contains special characters):
# MONGODB_URI=mongodb+srv://pixorify_app:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/Pixorify?retryWrites=true&w=majority
MONGODB_URI=

# Secret for signing JWT access tokens — use a long random string in production.
JWT_SECRET=

# Optional: JWT expiry (default 7d)
# JWT_EXPIRES_IN=7d

# Public base URL of THIS backend, used to build absolute URLs for generated
# images served from /generated/<file>.png. REQUIRED in production so that
# image URLs returned to the frontend don't point at localhost. No trailing slash.
# Example (Render):
# BACKEND_PUBLIC_URL=https://pixorify-backend-p5vv.onrender.com
BACKEND_PUBLIC_URL=

# Comma-separated list of additional CORS origins allowed to call this API
# (http://localhost:5173 is always allowed). Example for the deployed frontend:
# ALLOWED_ORIGINS=https://pixorify.vercel.app
ALLOWED_ORIGINS=

# ClipDrop API key — text-to-image (generate) + image-to-image (refine: inpainting, replace-background, reimagine)
CLIPDROP_API=

# Cloudinary credentials for persistent image storage. REQUIRED in production
# because Render's filesystem is ephemeral (everything in /public/generated is
# wiped on every redeploy). Sign up free at https://cloudinary.com, then copy
# these from the Dashboard. If unset, the backend falls back to local disk
# (works locally; images vanish on every redeploy in production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
