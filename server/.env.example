# Copy to .env and fill values.

# HTTP port for Express (default 4000 if omitted)
PORT=4000

# MongoDB Atlas connection string (required). Database name is part of the URI path; case-sensitive.
# Format (Atlas driver connection):
# mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
#
# Example (password must be URL-encoded if it contains special characters):
# MONGODB_URI=mongodb+srv://pixora_app:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/Pixora?retryWrites=true&w=majority
MONGODB_URI=

# Secret for signing JWT access tokens — use a long random string in production.
JWT_SECRET=

# Optional: JWT expiry (default 7d)
# JWT_EXPIRES_IN=7d

# Public base URL for saved ClipDrop images (defaults to http://localhost:<PORT>)
# BACKEND_PUBLIC_URL=http://localhost:4000

# ClipDrop text-to-image API key — https://clipdrop.co/apis/docs/text-to-image
CLIPDROP_API=
