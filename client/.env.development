# Local dev: use Vite proxy → http://localhost:4000 (see vite.config.js).
# Overrides client/.env so npm run dev hits your machine, not Render.
VITE_BACKEND_URL=
VITE_PROXY_TARGET=http://localhost:4000

# Show credits in navbar + Studio (also on by default in dev unless set to false).
VITE_CREDITS_UI_ENABLED=true
